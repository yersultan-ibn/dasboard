# Copy to .env.local for local overrides, or set these in your host (e.g. Vercel).
# All variables are public (NEXT_PUBLIC_*) — no secrets in this project.

# Which environment this build represents: "development" | "production".
# Drives the banner, logging verbosity and feature defaults. Prefer this over
# NODE_ENV, which is always "production" on a deployed host.
NEXT_PUBLIC_APP_ENV=development

# Base URL of the data API (SpaceX v4 by default). Point to different backends
# per environment here.
NEXT_PUBLIC_API_BASE_URL=https://api.spacexdata.com/v4

# Non-empty label shows the environment banner; leave empty to hide it.
NEXT_PUBLIC_ENV_BANNER=DEVELOPMENT

# Feature flag: enables the news/launch card widget.
NEXT_PUBLIC_FEATURE_NEWS_WIDGET=true
